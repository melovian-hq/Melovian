{
  "name": "melovian-frontend",
  "private": true,
  "version": "0.1.0",
  "author": "Quad4",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:property": "vitest run --config vitest.contract.config.ts",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts",
    "test:exploratory": "vitest run --config vitest.exploratory.config.ts",
    "test:oracle": "vitest run --config vitest.oracle.config.ts",
    "test:mutation": "stryker run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:ui": "playwright test --ui",
    "lighthouse": "VITE_STATIC_DEMO=true pnpm build && lhci autorun",
    "lighthouse:ci": "lhci autorun"
  },
  "dependencies": {
    "@iconify/svelte": "^5.2.2",
    "@sentry/svelte": "^10.71.0",
    "@wailsio/runtime": "3.0.0-beta.8",
    "xxhashjs": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.55.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "fast-check": "4.5.3",
    "globals": "^17.9.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^3.2.7"
  }
}
