# Copy to .env: cp .env.example .env

# Core
MELOVIAN_LISTEN=127.0.0.1:17337
MELOVIAN_DATA=
CACHE_ENABLED=true

# Multi-user server / Docker (unset for desktop dev)
# MELOVIAN_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# MELOVIAN_PUBLIC_URL=https://melovian.example.com
# Extra CORS origins for credentialed clients (https://wails.localhost is always allowed for the mobile app)
# MELOVIAN_CORS_ORIGINS=https://other.example.com

# Public read-only demo (server mode).
# With no NAVIDROME_* set, Melovian serves a built-in fake catalog (invented
# artists, albums, playlists, and silent audio). Point NAVIDROME_* at a real
# Subsonic server instead if you want a live upstream library.
# MELOVIAN_DEMO_MODE=true
# NAVIDROME_SERVER=fake://melovian-demo
# NAVIDROME_USER=demo
# NAVIDROME_PASSWORD=demo

# IP allowlist (comma-separated IPs/CIDRs; empty = allow all)
# MELOVIAN_ALLOWED_IPS=192.168.0.0/16,10.0.0.0/8
# MELOVIAN_TRUST_PROXY=true

# OIDC (requires MELOVIAN_AUTH_SECRET and MELOVIAN_PUBLIC_URL)
# MELOVIAN_OIDC_ISSUER=https://auth.example.com/realms/melovian
# MELOVIAN_OIDC_CLIENT_ID=melovian
# MELOVIAN_OIDC_CLIENT_SECRET=
# MELOVIAN_OIDC_REDIRECT_URL=
# MELOVIAN_OIDC_SCOPES=openid profile email

# Local library (desktop: on by default; authenticated server: off unless set)
# MELOVIAN_LOCAL_LIBRARY=true
# MELOVIAN_LOCAL_LIBRARY_PATH=/music

# Expose local library over Subsonic-compatible /rest (default on when local library is enabled)
# MELOVIAN_SUBSONIC_SERVER=true

# DLNA/UPnP media server for LAN renderers (off by default)
# MELOVIAN_DLNA_SERVER=true
# MELOVIAN_DLNA_HOST=0.0.0.0
# MELOVIAN_DLNA_PORT=8200

# Optional Subsonic bootstrap (migrated into the first saved server on first run)
NAVIDROME_SERVER=http://localhost:4533
NAVIDROME_USER=your-navidrome-username
NAVIDROME_PASSWORD=your-navidrome-password

# Dev only: Vite proxy target for /api
# MELOVIAN_API_URL=http://127.0.0.1:17337

# Desktop only (logging)
# MELOVIAN_LOG_LEVEL=debug
# MELOVIAN_LOG_FILE=
# MELOVIAN_DEBUG_PPROF=true

# Error tracking (Sentry-compatible GlitchTip or Sentry)
# MELOVIAN_SENTRY_DSN=https://glitchtip.example/api/1/store/
# MELOVIAN_SENTRY_FRONTEND_DSN=
# MELOVIAN_SENTRY_ENVIRONMENT=development
# MELOVIAN_SENTRY_RELEASE=melovian@0.1.0
# MELOVIAN_SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_DSN=
# SENTRY_FRONTEND_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=

# Frontend build-time Sentry (optional, for early boot before /api/config)
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=
# VITE_SENTRY_RELEASE=
# VITE_SENTRY_TRACES_SAMPLE_RATE=
